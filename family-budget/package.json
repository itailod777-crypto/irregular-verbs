{
  "name": "family-budget",
  "version": "1.0.0",
  "private": true,
  "description": "ניהול הוצאות והכנסות משפחתי - מקומי בלבד",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server.js",
    "sync": "node scripts/sync.js",
    "set-credentials": "node scripts/set-credentials.js",
    "seed-demo": "node scripts/seed-demo.js",
    "test": "node --test test/*.test.js",
    "demo": "node scripts/demo.js",
    "backup": "node scripts/backup.js",
    "make-samples": "node scripts/make-samples.js",
    "desktop": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "israeli-bank-scrapers": "^6.8.0"
  },
  "main": "desktop/main.js",
  "author": "Family",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "local.familybudget.app",
    "productName": "Family Budget",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**",
      "src/**",
      "public/**",
      "server.js",
      "package.json",
      "build/icon.png"
    ],
    "asarUnpack": [
      "node_modules/puppeteer*/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "תקציב המשפחה"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.finance"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Office"
    }
  }
}